# QiVo Studio Enterprise (compose). Copy to .env and fill in; never commit .env.

# The store (PostgreSQL in the compose project)
POSTGRES_PASSWORD=change-me

# The first administrator, created on the first start (password: at least 12 characters, upper and lower case, a digit)
QIVO_ADMIN_EMAIL=admin@example.com
QIVO_ADMIN_PASSWORD=
QIVO_ORGANISATION=Example Ltd

# The Oracle database to scan (read-only account; `qivo preflight` lists what it needs). Connections can also be
# added in the app (Connections). Easy Connect: host:port/service.
ORACLE_DSN=
ORACLE_LINEAGE_USER=
ORACLE_LINEAGE_PASSWORD=

# Optional: a sandbox for compiling uploads and probe runs, in a CDB you control (never production). Set up with
# sandbox/README.md, then check with: docker compose exec app qivo sandbox-check
QIVO_SANDBOX=                # "no": do not ask about a sandbox at first sign-in (install.sh sets it)
SANDBOX_POOL=
SANDBOX_DSN=
SANDBOX_LOADER_USER=
SANDBOX_LOADER_PASSWORD=
SANDBOX_CDB_DSN=
SANDBOX_POOL_USER=
SANDBOX_POOL_PASSWORD=
SANDBOX_DATAFILES=

# Optional: single sign-on with OpenID Connect (Microsoft Entra ID, Okta, Keycloak...). Register an app at your
# identity provider with the redirect URI <QIVO_PUBLIC_URL>/api/auth/oidc/callback (web platform, code flow).
QIVO_PUBLIC_URL=http://localhost:8000
QIVO_OIDC_ISSUER=
QIVO_OIDC_CLIENT_ID=
QIVO_OIDC_CLIENT_SECRET=
QIVO_OIDC_NAME=Microsoft Entra ID
QIVO_OIDC_DOMAINS=
QIVO_OIDC_AUTO_CREATE=false
QIVO_OIDC_ADMIN_GROUP=

# Optional: the master key for stored connection passwords (a Fernet key) from your key vault. Without it a key
# is created on first use in the "secrets" volume: back that volume up with the store.
LINEAGE_MASTER_KEY=

# Optional
QIVO_PORT=8000
QIVO_WORKERS=1
LINEAGE_WORKERS=2
